# NexMind P8 — provider-neutral capability routing. No provider/model identity is baked into source.
NEXMIND_P8_BUILD_HASH=
NEXMIND_API_KEY=
NEXMIND_MODEL_REGISTRY_JSON=
NEXMIND_RUNTIME_BOOT_ATTESTATION_JSON=
# Optional provider-neutral logical lanes. Exact role overrides take precedence.
NEXMIND_CREATIVE_PROVIDER=
NEXMIND_CREATIVE_MODEL=
NEXMIND_CREATIVE_BASE_URL=
NEXMIND_CREATIVE_API_KEY_ENV=NEXMIND_API_KEY
NEXMIND_CREATIVE_API_MODE=
NEXMIND_CREATIVE_INPUT_MODALITIES=
NEXMIND_REVIEW_PROVIDER=
NEXMIND_REVIEW_MODEL=
NEXMIND_REVIEW_BASE_URL=
NEXMIND_REVIEW_API_KEY_ENV=NEXMIND_API_KEY
NEXMIND_REVIEW_API_MODE=
NEXMIND_REVIEW_INPUT_MODALITIES=images,audio
NEXMIND_REVIEW_AUDIO_INPUT_MODE=
# Exact final-review roles. They may resolve to the SAME capable model; independence is enforced by separate role calls, blind context, and exact-media evidence. Both roles must accept image+native-audio.
NEXMIND_FINAL_EXECUTIVE_PRODUCER_PROVIDER=
NEXMIND_FINAL_EXECUTIVE_PRODUCER_MODEL=
NEXMIND_FINAL_EXECUTIVE_PRODUCER_BASE_URL=
NEXMIND_FINAL_EXECUTIVE_PRODUCER_API_KEY_ENV=NEXMIND_API_KEY
NEXMIND_FINAL_EXECUTIVE_PRODUCER_INPUT_MODALITIES=images,audio
NEXMIND_FINAL_EXECUTIVE_PRODUCER_AUDIO_INPUT_MODE=
NEXMIND_PERCEPTUAL_AUDITOR_PROVIDER=
NEXMIND_PERCEPTUAL_AUDITOR_MODEL=
NEXMIND_PERCEPTUAL_AUDITOR_BASE_URL=
NEXMIND_PERCEPTUAL_AUDITOR_API_KEY_ENV=NEXMIND_API_KEY
NEXMIND_PERCEPTUAL_AUDITOR_INPUT_MODALITIES=images,audio
NEXMIND_PERCEPTUAL_AUDITOR_AUDIO_INPUT_MODE=
# Editorial-motion-v2 story analyst (make_reel.py --analyst auto|llm): replaces the
# keyword entity-bank treatment with an LLM-authored treatment (arc, scenes,
# metaphor/entity inventory, motif). Replays a recorded payload when STORY_ANALYST_REPLAY is set.
STUDIO_ANALYST=
NEXMIND_STORY_ANALYST_MODEL=
NEXMIND_STORY_ANALYST_BASE_URL=
NEXMIND_STORY_ANALYST_API_KEY_ENV=NEXMIND_API_KEY
NEXMIND_STORY_ANALYST_TIMEOUT_S=
STORY_ANALYST_REPLAY=
# Production execution capabilities — registries are validated/probed before quote and again before debit.
NEXSTUDIO_ART_EXECUTION_REGISTRY_JSON=
# Voice routes, tried in priority order. chatterbox-turbo is the default free engine
# (Resemble AI, MIT — `pip install chatterbox-tts` on the render host; GPU recommended).
# ElevenLabs stays declared as the premium option: credentialEnv gates it, so it is
# skipped automatically until ELEVENLABS_API_KEY is set. See voice/*_route.py docstrings.
NEXSTUDIO_TTS_ROUTES_JSON=[{"id":"chatterbox-turbo","priority":20,"commercialUseAllowed":true,"timeoutSeconds":600,"command":["python3","engine_sources/editorial-motion-v2/voice/chatterbox_route.py"]},{"id":"elevenlabs","priority":10,"commercialUseAllowed":true,"credentialEnv":"ELEVENLABS_API_KEY","timeoutSeconds":120,"command":["python3","engine_sources/editorial-motion-v2/voice/elevenlabs_route.py"]}]
NEXSTUDIO_MUSIC_ROUTES_JSON=
# Talking-avatar video routes, tried in priority order. sadtalker-local is the default
# free engine (Apache 2.0 — clone OpenTalker/SadTalker + checkpoints on the render host;
# runs on CPU, GPU recommended). Same registry contract as TTS routes:
# a credentialEnv-gated route drops out automatically until its key is set.
# See avatar/*_route.py docstrings.
NEXSTUDIO_AVATAR_ROUTES_JSON=[{"id":"sadtalker-local","priority":20,"commercialUseAllowed":true,"timeoutSeconds":3600,"command":["python3","engine_sources/editorial-motion-v2/avatar/sadtalker_route.py"]}]
# SadTalker avatar route. Optional tuning:
# SADTALKER_ROOT=/path/to/SadTalker checkout (contains inference.py + checkpoints/),
# SADTALKER_PYTHON=/path/to/venv python with torch+deps,
# SADTALKER_DEVICE=cuda|cpu (default: cuda when torch reports it),
# SADTALKER_TRANSPORT=fixture:/path/video.mp4 (replay a file; tests only).
SADTALKER_ROOT=
SADTALKER_PYTHON=
SADTALKER_DEVICE=
STUDIO_BROWSER_COMMAND=
STUDIO_CHROMIUM_PATH=
# Engine roots are installed/frozen authorities; standalone QA verifies their archive hashes.
STUDIO_WHITEBOARD_ENGINE_ROOT=./engines/whiteboard/Whiteboard_Execution_Body_V2
STUDIO_EXPLAINER_ENGINE_ROOT=./engines/explainer/NexStudio_Explainer_Execution_Body_V2
STUDIO_EDITORIAL_ENGINE_ROOT=./engines/editorial
# Editorial Motion v2 (P8 treatment -> plan compiler -> execution-only runtime) is unpacked, not archived.
STUDIO_EDITORIAL_V2_ROOT=./engine_sources/editorial-motion-v2
# Chatterbox voice route (default engine). Optional tuning:
# CHATTERBOX_MODEL=turbo|standard|multilingual, CHATTERBOX_DEVICE=cuda|cpu,
# CHATTERBOX_VOICE_PROMPT=/path/to/10s-reference.wav (default clone voice),
# CHATTERBOX_TRANSPORT=fixture:/path/audio.wav (replay a file; tests only).
CHATTERBOX_MODEL=turbo
CHATTERBOX_DEVICE=
CHATTERBOX_VOICE_PROMPT=
# ElevenLabs is the premium option in NEXSTUDIO_TTS_ROUTES_JSON; setting this key
# activates the declared route — the key is read from this variable only.
ELEVENLABS_API_KEY=
STUDIO_STICKMAN_ENGINE_ROOT=./engines/stickman/NEXSTICK_MASTER_V2_UNIFIED_PERFORMANCE_V5_1_CLEAN_2026-08-13
# NexStick consolidated Blender performance system (canonical master + frozen action core + registries/adapters).
STUDIO_STICKMAN_PERFORMANCE_ENGINE_ROOT=./engines/stickman-performance/NEXSTICK_COMPLETE_PERFORMANCE_PACKAGE
# NITA/VITA richer semantic performance donor system (306 actions, presenter flows, router contract)
STUDIO_NITA_MOTION_ENGINE_ROOT=./engines/nita-motion/NITA_COMPLETE_CHARACTER_MOTION_SYSTEM
STUDIO_SOUND_LIBRARY_ROOT=./engines/sound
STUDIO_NEXMIND_P8_BRIDGE_MODE=process
STUDIO_NEXMIND_P8_PYTHON_BIN=python3
STUDIO_EXPLAINER_TSX_BIN=
OBJECT_STORAGE_LOCAL_ROOT=./data/objects
OBJECT_STORAGE_ALLOW_LOCAL_PRODUCTION=true
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studio?schema=public
STUDIO_OPERATOR_USER_IDS=
STUDIO_FIRST_PRODUCTION_DISCOUNT_ENABLED=true
STUDIO_FIRST_PRODUCTION_DISCOUNT_PERCENT=10
# Trust/commerce/account values — never commit real credentials.
STUDIO_TRUST_SECRET=
DATABASE_POOL_MAX=10
STUDIO_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STUDIO_STRIPE_LIVE_REQUIRED=true
STUDIO_UPLOAD_MAX_BYTES=52428800
CLAMAV_HOST=
CLAMAV_PORT=3310
STUDIO_ASSET_TICKET_TTL_SECONDS=300
TRUST_TEST_DATABASE_URL=
TRUST_TEST_ALLOW_DESTRUCTIVE=false

# --- Render queue + storage (production move) ---
# pg-boss render queue: "on" drains jobs via the render worker
# (npm run worker:renders / node dist/render-worker.cjs); "off" reverts to
# detached in-process spawns for standalone dev.
RENDER_QUEUE=on
# Jobs in flight (queued + running) before POSTs get 429. Queue on: backlog cap.
STUDIO_MAX_QUEUED_RENDERS=25
# Jobs per worker process — 1 per ~4 CPU cores is the honest ratio.
RENDER_WORKER_CONCURRENCY=1

# Output storage: "local" (job-dir files, default) or "s3".
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_PUBLIC_BASE_URL=

# Engine toolchain paths (Docker image defaults shown).
WHISPER_PYTHON=
NEXSTUDIO_WHISPER_PYTHON=
MFA_BIN=
BLENDER_BIN=
CHROME_PATH=

# Required whenever NODE_ENV=production (also at `next build`). >=32 chars.
#   openssl rand -hex 32
STUDIO_TRUST_SECRET=
# Public origin — must be https:// in production.
APP_ORIGIN=http://localhost:3000
