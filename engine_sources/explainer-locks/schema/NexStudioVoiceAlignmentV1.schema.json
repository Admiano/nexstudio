{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexstudio.dev/schema/NexStudioVoiceAlignmentV1.json",
  "title": "NexStudioVoiceAlignmentV1",
  "type": "object",
  "properties": {
    "characters": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1
      }
    },
    "character_start_times_seconds": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
