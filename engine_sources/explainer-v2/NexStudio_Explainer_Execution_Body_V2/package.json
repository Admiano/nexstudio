{
  "name": "nexmarkets-nexstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "smoke": "node scripts/smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:dev-auth": "node scripts/dev-auth-smoke.mjs",
    "grok:x": "tsx scripts/grok-x-account.ts",
    "workers:once": "tsx scripts/workers.ts",
    "workers:watch": "tsx scripts/workers.ts --watch",
    "workers:studio": "tsx scripts/studio-worker.ts --watch",
    "workers:studio:once": "tsx scripts/studio-worker.ts",
    "workers:studio:retention": "tsx scripts/studio-retention-worker.ts",
    "studio:contracts:validate": "node scripts/validate-studio-contracts.mjs",
    "studio:eval": "vitest run evaluations/studio/studio-evaluation.test.ts",
    "studio:qa:smoke": "tsx scripts/studio-qa-smoke.ts",
    "studio:ledger:reconcile": "tsx scripts/studio-ledger-reconcile.ts",
    "studio:concurrency:probe": "node scripts/studio-concurrency-probe.mjs",
    "studio:quote-security:probe": "node scripts/studio-quote-security-probe.mjs",
    "studio:infographic:real-smoke": "node scripts/studio-real-infographic-smoke.mjs",
    "studio:mp4:real-provider-smoke": "tsx scripts/studio-real-mp4-provider-smoke.mjs",
    "studio:kimi:smoke": "tsx scripts/kimi-k3-smoke.ts",
    "studio:kimi:composition-smoke": "tsx scripts/kimi-k3-composition-smoke.ts",
    "studio:library:build": "tsx scripts/build-scene-library.ts",
    "studio:library:preview": "tsx scripts/preview-scene-library.ts",
    "studio:product-launch": "tsx scripts/product-launch-scenes.ts",
  "studio:product-launch:validate": "tsx scripts/validate-product-launch-library.ts",
  "studio:nexmarkets:dry-run": "tsx scripts/dry-run-nexmarkets-recovery.ts",
    "studio:product-launch:backfill": "tsx scripts/backfill-product-launch-private-source.ts",
    "studio:product-launch:private-smoke": "tsx scripts/private-product-launch-smoke.ts",
    "studio:product-launch:metadata": "tsx scripts/build-product-launch-metadata.ts",
    "security:scan": "tsx scripts/scan-secrets.ts",
    "studio:nexstudios:promote-asset": "tsx scripts/nexstudios-promote-asset.ts",
    "studio:nexstudios:review": "tsx scripts/nexstudios-review.ts",
    "studio:nexstudios:audit": "tsx scripts/nexstudios-audit-packs.ts",
    "studio:elevenlabs:audition": "tsx scripts/elevenlabs-voice-audition.ts",
    "studio:whitelist": "tsx scripts/studio-whitelist.ts",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run contracts:compile && npm run contracts:test",
    "db:schema:dev": "node scripts/generate-sqlite-schema.mjs",
    "db:generate:postgres": "prisma generate",
    "db:generate:sqlite": "npm run db:schema:dev && prisma generate --config prisma.dev.config.ts",
    "db:generate": "node scripts/clean-generated-prisma.mjs && npm run db:generate:postgres && npm run db:generate:sqlite",
    "db:dev:push": "npm run db:schema:dev && prisma db push --config prisma.dev.config.ts",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "contracts:compile": "cd contracts && hardhat compile",
    "contracts:test": "cd contracts && hardhat test nodejs test/NexMarkets.ts --no-compile",
    "contracts:coverage": "cd contracts && hardhat test nodejs test/NexMarkets.ts --coverage --no-compile",
    "contracts:deploy:testnet": "cd contracts && hardhat ignition deploy ignition/modules/NexMarkets.ts --network robinhoodTestnet",
    "hyperframes:check": "cd hyperframes/example && npx --yes hyperframes@0.7.56 check",
    "hyperframes:preview": "cd hyperframes/example && npx --yes hyperframes@0.7.56 preview",
    "hyperframes:render:cloud": "cd hyperframes/example && npx --yes hyperframes@0.7.56 cloud render --quality standard --fps 30",
    "dev:next": "next dev",
    "gemini:live": "echo Gemini Live uses ephemeral tokens through the NexMarkets API route."
  },
  "dependencies": {
    "@hyperframes/core": "0.7.56",
    "@hyperframes/lint": "0.7.56",
    "@hyperframes/player": "0.7.56",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.101.2",
    "dotenv": "17.4.2",
    "fflate": "0.8.2",
    "gsap": "3.14.2",
    "next": "16.2.10",
    "pg": "8.22.0",
    "playwright-core": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.34.5",
    "tsx": "4.23.1",
    "viem": "2.55.1",
    "wagmi": "^3.7.1",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "26.1.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.10",
    "hardhat": "3.9.1",
    "js-yaml": "4.3.0",
    "prisma": "7.8.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
