{
  "schemaVersion": "1.0.0",
  "targetTypes": {
    "paper-object": {
      "selector": ".paper-object, .paper-component, [data-motion-type=\"paper-object\"]",
      "notes": "Any independently reusable paper component."
    },
    "text": {
      "selector": "[data-motion-type=\"text\"], .motion-text",
      "notes": "Editable text or caption container."
    },
    "svg": {
      "selector": "svg, [data-motion-type=\"svg\"]",
      "notes": "SVG path or abstract vector test glyph."
    },
    "data-label": {
      "selector": "[data-motion-number]",
      "notes": "Numeric text with data-motion-number."
    },
    "workflow": {
      "selector": "[data-connect-from] and [data-connect-to]",
      "notes": "Container holding two addressable workflow nodes."
    },
    "caption": {
      "selector": "[data-motion-type=\"caption\"]",
      "notes": "Text intended for marker or write effects."
    },
    "editorial-scene": {
      "selector": "[data-scene-style=\"editorial\"]",
      "notes": "Structured scene pair for transitions."
    },
    "collage-scene": {
      "selector": "[data-scene-style=\"collage\"]",
      "notes": "Layered scene pair for transitions."
    },
    "technical-scene": {
      "selector": "[data-scene-style=\"technical\"]",
      "notes": "Notebook or diagram scene pair for transitions."
    }
  },
  "motions": {
