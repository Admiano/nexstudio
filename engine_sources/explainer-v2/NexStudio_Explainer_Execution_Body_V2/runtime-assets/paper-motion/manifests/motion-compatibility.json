      "compatibleTargets": [
        "paper-object",
        "text",
        "svg"
      ],
      "createsOverlay": false,
      "restoresRestingState": true,
      "finite": true,
      "seekable": true,
      "conflicts": [
        "simultaneous-transform-motion"
      ]
    },
