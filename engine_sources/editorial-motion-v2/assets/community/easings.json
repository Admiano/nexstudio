{
  "schema": "NexStudioEasingsV1",
  "note": "Standard published cubic-bezier easing constants (as catalogued by easings.net and anime.js, MIT). Role names give the compiler a choreography vocabulary instead of one overshoot for everything.",
  "roles": {
    "enter": "easeOutExpo — arrives fast, lands soft; the workhorse for object/word entrances",
    "exit": "easeInQuint — accelerates away; exits never bounce",
    "emphasize": "easeOutBack — overshoot snap for stressed words and state changes",
    "settle": "easeOutQuint — long soft tail for carried entities and stage drift",
    "wipe": "easeInOutQuart — symmetrical, mask/scissor transitions",
    "bounce": "easeOutBounce — only for playful beats; avoid in serious editorial"
  },
  "curves": {
    "linear": [0.0, 0.0, 1.0, 1.0],
    "easeInSine": [0.12, 0.0, 0.39, 0.0],
    "easeOutSine": [0.61, 1.0, 0.88, 1.0],
    "easeInOutSine": [0.37, 0.0, 0.63, 1.0],
    "easeInQuad": [0.11, 0.0, 0.5, 0.0],
    "easeOutQuad": [0.5, 1.0, 0.89, 1.0],
    "easeInOutQuad": [0.45, 0.0, 0.55, 1.0],
    "easeInCubic": [0.32, 0.0, 0.67, 0.0],
    "easeOutCubic": [0.33, 1.0, 0.68, 1.0],
    "easeInOutCubic": [0.65, 0.0, 0.35, 1.0],
    "easeInQuart": [0.5, 0.0, 0.75, 0.0],
    "easeOutQuart": [0.25, 1.0, 0.5, 1.0],
    "easeInOutQuart": [0.76, 0.0, 0.24, 1.0],
    "easeInQuint": [0.64, 0.0, 0.78, 0.0],
    "easeOutQuint": [0.22, 1.0, 0.36, 1.0],
    "easeInOutQuint": [0.83, 0.0, 0.17, 1.0],
    "easeInExpo": [0.7, 0.0, 0.84, 0.0],
    "easeOutExpo": [0.16, 1.0, 0.3, 1.0],
    "easeInOutExpo": [0.87, 0.0, 0.13, 1.0],
    "easeInCirc": [0.55, 0.0, 1.0, 0.45],
    "easeOutCirc": [0.0, 0.55, 0.45, 1.0],
    "easeInOutCirc": [0.85, 0.0, 0.15, 1.0],
    "easeInBack": [0.36, 0.0, 0.66, -0.56],
    "easeOutBack": [0.34, 1.56, 0.64, 1.0],
    "easeInOutBack": [0.68, -0.6, 0.32, 1.6],
    "easeOutElastic": "elastic — not expressible as bezier; use runtime spring(k, d)",
    "easeOutBounce": "bounce — not expressible as bezier; use runtime bounce(t)"
  },
  "springs": {
    "snappy": {"stiffness": 320, "damping": 22},
    "gentle": {"stiffness": 120, "damping": 14},
    "wobbly": {"stiffness": 180, "damping": 12},
    "stiff": {"stiffness": 400, "damping": 30}
  },
