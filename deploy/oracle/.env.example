# Copy to deploy/oracle/.env. Keep this private and reuse it on updates.
STUDIO_DOMAIN=studio.example.com
# The full application address is separate from the restricted public site.
STUDIO_APP_DOMAIN=app.example.com
# Additional full-app hostnames and their HTTPS origins, separated by spaces.
STUDIO_APP_ALIASES=
APP_ADDITIONAL_ORIGINS=
# Legacy hostname metadata; the original application host is not redirected.
STUDIO_ALIASES=
APP_ORIGIN=https://app.example.com
# Use independent `openssl rand -hex 32` values (hex is safe in database URLs).
POSTGRES_PASSWORD=
STUDIO_TRUST_SECRET=
LOCAL_AI_API_KEY=

# Required for real sign-in emails. Use the existing configured Resend account.
RESEND_API_KEY=
EMAIL_FROM=

# Local AI is private inside the Compose network.
# These optional overrides select an external OpenAI-compatible service.
# Keep credentials in the private .env file. Configure all script role values
# together, or use scripts/configure-enclave.cjs with existing Enclave settings.
STUDIO_SCRIPT_OPENAI_API_URL=
STUDIO_SCRIPT_OPENAI_API_KEY=
STUDIO_PLAN_PREVIEW_OPENAI_API_URL=
STUDIO_PLAN_PREVIEW_OPENAI_API_KEY=
STUDIO_SCRIPT_MODEL=qwen2.5-3b-instruct
STUDIO_SCRIPT_TIMEOUT_MS=180000
RENDER_WORKER_CONCURRENCY=auto
RENDER_FRAME_WORKERS=auto
WHISPER_CPU_THREADS=auto
KOKORO_CPU_THREADS=auto
AI_THREADS=auto
AI_PARALLEL=auto
STUDIO_MAX_QUEUED_RENDERS=25

# Payment configuration, if accepting payments.
STUDIO_PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STUDIO_STRIPE_LIVE_REQUIRED=true

# Optional provider routing from .env.example goes here.
NEXMIND_API_KEY=
NEXMIND_MODEL_REGISTRY_JSON=
